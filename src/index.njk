---
layout: layouts/base.njk
bodyClass: page-home
---
{%- from "partials/macros.njk" import icon, playBadge %}
{%- set latest = collections.updates | limit(4) %}
{%- set st = profile | statusInfo %}
{%- set current = resume.experience[0] %}
{%- set tags = profile.taglines if (profile.taglines and profile.taglines | length) else [profile.role] %}

<section class="home">
  <div class="container">
    <header class="home-hero">
      {%- set nameParts = (profile.shortName or profile.name) | lower | wordmarkParts %}
      <h1 class="wordmark">
        <span class="wordmark-text" aria-hidden="true"><span class="wm-light">{{ nameParts[0] }}</span><span class="wm-bold">{{ nameParts[1] }}</span><span class="wm-dot"></span></span>
        <span class="sr-only">{{ profile.name }}</span>
      </h1>
      <div class="home-divider" aria-hidden="true"><i></i><span></span><i></i></div>
    </header>

    <div class="bento">
      {#- Photo -#}
      <figure class="card card-photo">
        <img src="{{ profile.photo }}" alt="Portrait of {{ profile.name }}" width="360" height="360" data-position="{{ profile.photoPosition or 'center' }}">
      </figure>

      {#- Status: compact box -#}
      <section class="card card-status status-{{ st.key }}" id="status" aria-labelledby="status-title">
        <header class="card-head">
          <h2 id="status-title">Status</h2>
          <span class="card-icon card-icon-status">{{ icon(st.icon) }}</span>
        </header>
        <p class="status-label"><span class="status-light" aria-hidden="true"></span><span>{{ st.label }}</span></p>
        {%- if st.note %}<p class="status-note">{{ st.note }}</p>{% endif %}
        {%- if st.hireable and st.jobTypes | length %}
        <ul class="job-tags" aria-label="Job preference">
          {%- for t in st.jobTypes %}<li>{{ icon("check") }}{{ t }}</li>{% endfor %}
        </ul>
        {%- endif %}
        <p class="status-time" hidden data-local-time-wrap>{{ icon("clock") }}<span><span data-local-time data-tz="{{ site.timezone }}"></span> in La Union</span></p>
        {%- if st.hireable %}
        <a class="btn btn-hire btn-small btn-block status-btn" href="/contact/">Hire me</a>
        {%- else %}
        <a class="btn btn-ghost btn-small btn-block status-btn" href="/contact/">Contact me</a>
        {%- endif %}
      </section>

      {#- Life updates: the big card at the top -#}
      <section class="card card-updates" aria-labelledby="updates-title">
        <header class="card-head">
          <h2 id="updates-title"><a href="/updates/">{{ site.updatesTitle }}</a></h2>
          <a class="link-arrow" href="/updates/">See all <span aria-hidden="true">→</span></a>
        </header>
        {%- if latest | length %}
        {%- set hero = latest[0] %}
        {%- set heroPhotos = hero.data | postPhotos %}
        {%- set heroCover = heroPhotos | first %}
        {%- set heroVideos = hero.data | postVideos %}
        {%- set heroSrc = heroCover.image if heroCover else ((heroVideos | selectattr("thumb") | first).thumb if heroVideos | length else "") %}
        <a class="update-hero" href="{{ hero.url }}">
          <span class="update-hero-media{% if not heroSrc %} thumb-empty{% endif %}">
            {%- if heroSrc %}<img src="{{ heroSrc }}" alt="{{ (heroCover.alt or heroCover.caption or hero.data.title) if heroCover else hero.data.title }}" decoding="async">{% else %}{{ icon("images") }}{% endif %}
          </span>
          {%- if heroVideos | length %}{{ playBadge(heroVideos | length, heroVideos) }}{% endif %}
          {%- if heroPhotos | length > 1 %}<span class="update-hero-count">{{ heroPhotos | length }} photos</span>{% endif %}
          <span class="update-hero-text">
            <span class="update-hero-badge">Latest</span>
            <strong>{{ hero.data.title }}</strong>
            <time datetime="{{ hero.date | isoDate }}">{{ hero.date | readableDate(site.timezone) }}</time>
          </span>
        </a>
        <ul class="thumbs">
          {%- for post in latest.slice(1, 4) %}
          {%- set cover = (post.data | postPhotos) | first %}
          {%- set vids = post.data | postVideos %}
          {%- set thumbSrc = cover.image if cover else ((vids | selectattr("thumb") | first).thumb if vids | length else "") %}
          <li>
            <a class="thumb" href="{{ post.url }}">
              <span class="thumb-media{% if not thumbSrc %} thumb-empty{% endif %}">
                {%- if thumbSrc %}<img src="{{ thumbSrc }}" alt="" loading="lazy" decoding="async">{% else %}{{ icon("images") }}{% endif %}
                {%- if vids | length %}{{ playBadge(vids | length, vids) }}{% endif %}
              </span>
              <span class="thumb-title">{{ post.data.title }}</span>
            </a>
          </li>
          {%- endfor %}
          {%- for i in range(latest | length, 4) %}
          <li class="thumb-soon" aria-hidden="true"><span class="thumb-media thumb-empty"></span><span class="thumb-title">More soon</span></li>
          {%- endfor %}
        </ul>
        {%- else %}
        <p class="empty-state">No updates yet. Check back soon!</p>
        {%- endif %}
      </section>

      {#- Moving ribbons with the roles -#}
      <div class="card card-ribbon">
        <h2 class="sr-only">What I am</h2>
        <ul class="sr-only">{% for t in tags %}<li>{{ t }}</li>{% endfor %}</ul>
        {%- set line %}{% for t in tags %}{{ t }} // {% endfor %}{% endset %}
        <div class="tape tape-a" aria-hidden="true"><div class="tape-track"><span>{{ line | safe }}{{ line | safe }}</span><span>{{ line | safe }}{{ line | safe }}</span></div></div>
        <div class="tape tape-b" aria-hidden="true"><div class="tape-track"><span>{{ line | safe }}{{ line | safe }}</span><span>{{ line | safe }}{{ line | safe }}</span></div></div>
      </div>

      {#- Current role: small and quiet -#}
      {%- if current %}
      <section class="card card-role" aria-labelledby="role-title">
        <header class="card-head">
          <h2 id="role-title">Current Role</h2>
          <span class="card-icon">{{ icon("briefcase") }}</span>
        </header>
        <h3 class="role-title">{{ current.role }}</h3>
        <p class="role-org">{{ current.organization }}</p>
        <p class="role-years">{{ current.start }}{% if current.end and current.end != current.start %} – {{ current.end }}{% endif %}</p>
        {%- if profile.highlights | length %}
        <ul class="role-stats">
          {%- for stat in profile.highlights %}
          <li><strong>{{ stat.value }}</strong> {{ stat.label }}</li>
          {%- endfor %}
        </ul>
        {%- endif %}
        <a class="link-arrow role-link" href="/resume/">View resume <span aria-hidden="true">→</span></a>
      </section>
      {%- endif %}

      {#- What I do: short, resume-based -#}
      {%- if profile.services | length %}
      <section class="card card-services" aria-labelledby="services-title">
        <header class="card-head">
          <h2 id="services-title">What I do</h2>
          <span class="card-icon">{{ icon("support") }}</span>
        </header>
        <ul class="services">
          {%- for service in profile.services %}
          {%- if service.title %}
          <li>
            <span class="service-icon">{{ icon(service.icon or "star") }}</span>
            <span class="service-text"><strong>{{ service.title }}</strong>{% if service.description %}<span>{{ service.description }}</span>{% endif %}</span>
          </li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}

      {#- Interests -#}
      {%- if profile.interests | length %}
      <section class="card card-interests" aria-labelledby="interests-title">
        <header class="card-head">
          <h2 id="interests-title">Interests</h2>
          <span class="card-icon">{{ icon("heart") }}</span>
        </header>
        <ul class="interests">
          {%- for item in profile.interests %}
          {%- if item.name %}
          {%- set info = collections.updateTags | tagInfo(item.name) %}
          <li><a class="interest" href="/updates/tags/{{ item.name | tagSlug }}/" aria-label="{{ item.name }}: {{ info.count }} {{ 'update' if info.count == 1 else 'updates' }}"><span class="interest-icon">{{ icon(item.icon or "star") }}</span><span class="interest-name">{{ item.name }}</span>{% if info.count %}<span class="interest-count">{{ info.count }}</span>{% endif %}</a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}

    </div>
  </div>
</section>
