---
layout: layouts/base.njk
pagination:
  data: collections.updates
  size: 8
  alias: posts
permalink: "/updates/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  title: "{{ site.updatesTitle }}{% if pagination.pageNumber > 0 %} (page {{ pagination.pageNumber + 1 }}){% endif %}"
bodyClass: page-updates
---
{%- from "partials/macros.njk" import photoGrid, tagList, videoEmbed %}

<section class="page-hero page-hero-center">
  <div class="container narrow">
    <p class="section-label">Blog</p>
    <h1 class="page-title">{{ site.updatesTitle }}</h1>
    <p class="page-lead">{{ site.updatesIntro }}</p>
    {%- if collections.updateTags | length %}
    <ul class="tag-cloud" aria-label="Browse by tag">
      {%- for tag in collections.updateTags %}{% if tag.count and loop.index0 < 40 %}
      <li><a href="/updates/tags/{{ tag.slug }}/">#{{ tag.name }} <span>{{ tag.count }}</span></a></li>
      {%- endif %}{% endfor %}
    </ul>
    {%- endif %}
  </div>
</section>

<div class="container narrow">
  {%- if posts | length %}
  <div class="feed">
    {%- for post in posts %}
    {%- set photos = post.data | postPhotos %}
    {%- set videos = post.data | postVideos %}
    <article class="post-card">
      <header class="post-card-head">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate(site.timezone) }}</time>
        {%- if post.data.draft %}<span class="badge">Draft (only visible locally)</span>{% endif %}
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      </header>
      {%- set text = ((post.data.blocks | blocksText) + " " + (post.content | plainText)) | trim %}
      {%- set storyFirst = post.data | startsWithText %}
      {%- if text and storyFirst %}
      <p class="post-card-text">{{ text | truncateWords(45) }}</p>
      {%- endif %}
      {{ photoGrid(photos, "post-" + loop.index + "-" + pagination.pageNumber, post.data.title) }}
      {%- if videos | length %}{{ videoEmbed(videos[0], post.data.title) }}{% endif %}
      {%- if photos | length == 1 and photos[0].caption %}
      <div class="post-card-caption">{{ photos[0].caption | mdInline | safe }}</div>
      {%- endif %}
      {%- if text and not storyFirst %}
      <p class="post-card-text">{{ text | truncateWords(45) }}</p>
      {%- endif %}
      <footer class="post-card-foot">
        {{ tagList(post.data.tags) }}
        <a class="link-arrow" href="{{ post.url }}">{% if photos | length > 1 %}See all {{ photos | length }} photos{% elif videos | length > 1 %}See all {{ videos | length }} videos{% else %}Read more{% endif %} <span aria-hidden="true">→</span></a>
      </footer>
    </article>
    {%- endfor %}
  </div>

  {%- if pagination.pages | length > 1 %}
  <nav class="pager" aria-label="More updates">
    {%- if pagination.href.previous %}<a class="btn btn-ghost" href="{{ pagination.href.previous }}">← Newer</a>{% else %}<span></span>{% endif %}
    <span class="pager-info">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}</span>
    {%- if pagination.href.next %}<a class="btn btn-ghost" href="{{ pagination.href.next }}">Older →</a>{% else %}<span></span>{% endif %}
  </nav>
  {%- endif %}
  {%- else %}
  <p class="empty-state">No updates yet. Check back soon!</p>
  {%- endif %}
</div>
