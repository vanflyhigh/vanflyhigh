---
layout: layouts/base.njk
title: Resume
description: Experience, education, certifications, and skills of Van David Niccolo Fontanilla.
permalink: /resume/
bodyClass: page-resume
---
<section class="page-hero">
  <div class="container">
    <p class="section-label">{% if (profile | statusInfo).hireable %}Hire me · {% endif %}Resume</p>
    <h1 class="page-title">{{ profile.name }}</h1>
    <p class="page-lead">{{ profile.summary }}</p>
    <div class="hero-actions no-print">
      {%- if profile.resumeFile %}
      <a class="btn btn-primary" href="{{ profile.resumeFile }}" target="_blank" rel="noopener" data-print-pdf>Print resume</a>
      <a class="btn btn-ghost" href="{{ profile.resumeFile }}" target="_blank" rel="noopener">View / download PDF</a>
      {%- endif %}
      <a class="btn {% if profile.resumeFile %}btn-ghost{% else %}btn-primary{% endif %}" href="mailto:{{ profile.email }}">Email me</a>
    </div>
  </div>
</section>

<div class="container resume-grid">
  <section class="resume-main" aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="pill-heading">Professional experience</h2>
    <ol class="timeline">
      {%- for job in resume.experience %}
      <li class="timeline-item">
        <div class="timeline-head">
          <div>
            <h3>{{ job.role }}</h3>
            <p class="timeline-org">{{ job.organization }}</p>
          </div>
          <span class="timeline-years">{{ job.start }}{% if job.end and job.end != job.start %} – {{ job.end }}{% endif %}</span>
        </div>
        {%- if job.responsibilities | length %}
        <ul class="bullets">
          {%- for item in job.responsibilities %}
          <li>{{ item }}</li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>

    <h2 class="pill-heading">Top skills</h2>
    <div class="skills-block">
      <div>
        <h3>Professional</h3>
        <ul class="chip-list">
          {%- for skill in resume.skills.professional %}<li>{{ skill }}</li>{% endfor %}
        </ul>
      </div>
      {%- if resume.skills.tools | length %}
      <div>
        <h3>Tools &amp; technologies</h3>
        <ul class="chip-list chip-list-muted">
          {%- for skill in resume.skills.tools %}<li>{{ skill }}</li>{% endfor %}
        </ul>
      </div>
      {%- endif %}
      <div>
        <h3>Soft skills</h3>
        <ul class="chip-list chip-list-muted">
          {%- for skill in resume.skills.soft %}<li>{{ skill }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </section>

  <aside class="resume-side" aria-label="Education, certifications, languages, and contact">
    <div class="side-block">
      <h2 class="side-heading">Education</h2>
      <ul class="side-list">
        {%- for item in resume.education %}
        <li>
          <strong>{{ item.school }}</strong>
          <em>{{ item.credential }}</em>
          <span>{{ item.year }}</span>
        </li>
        {%- endfor %}
      </ul>
    </div>

    {%- if resume.certifications | length %}
    <div class="side-block">
      <h2 class="side-heading">Certifications</h2>
      <ul class="side-list">
        {%- for item in resume.certifications %}
        <li>
          <strong>{{ item.name }}</strong>
          <em>{{ item.issuer }}</em>
          <span>Completed {{ item.year }}</span>
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}

    <div class="side-block">
      <h2 class="side-heading">Languages</h2>
      <ul class="lang-list">
        {%- for lang in resume.languages %}
        {%- set level = lang.level or 0 %}
        <li>
          <span>{{ lang.name }}</span>
          <span class="lang-meter" role="img" aria-label="{{ level }} out of 5">
            {%- for i in range(1, 6) %}<i class="{{ 'on' if i <= level else '' }}"></i>{% endfor %}
          </span>
        </li>
        {%- endfor %}
      </ul>
    </div>

    <div class="side-block">
      <h2 class="side-heading">Contact</h2>
      <ul class="side-contact">
        <li><span>Email</span><a href="mailto:{{ profile.email }}">{{ profile.email }}</a></li>
        {%- if profile.phone %}
        <li><span>Phone</span><a href="{{ profile.phone | telHref }}">{{ profile.phone }}</a></li>
        {%- endif %}
        <li><span>Address</span>{{ profile.location }}</li>
      </ul>
    </div>
  </aside>
</div>
