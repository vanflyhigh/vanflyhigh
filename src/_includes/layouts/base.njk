<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.title) if title else (profile.name + " · " + profile.role) %}
  {%- set pageDescription = description or site.description %}
  {%- set pageImage = ogImage or profile.photo %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title or profile.name }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:image" content="{{ pageImage | absoluteUrl }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#070b14">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {%- if page.url == "/" %}
  <script type="application/ld+json">{{ profile | personJsonLd(resume) | safe }}</script>
  {%- endif %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}: {{ site.updatesTitle }}" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@300;400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  <script>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    })();
    window.gifFallback = function (v) {
      var src = v.getAttribute("data-fallback");
      if (!src || v.getAttribute("data-failed")) return;
      v.setAttribute("data-failed", "1");
      var img = document.createElement("img");
      img.className = v.className; img.src = src; img.alt = v.getAttribute("aria-label") || ""; img.loading = "lazy";
      v.replaceWith(img);
    };
  </script>
  <script src="/assets/js/main.js?v={{ build.version }}" defer></script>
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/lightbox.njk" %}
</body>
</html>
