<dialog class="lightbox" data-lightbox aria-label="Photo viewer">
  <div class="lightbox-inner">
    <button class="lightbox-btn lightbox-close" type="button" data-lightbox-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <button class="lightbox-btn lightbox-prev" type="button" data-lightbox-prev aria-label="Previous photo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <figure class="lightbox-figure">
      <img data-lightbox-img alt="">
      <figcaption>
        <span class="lightbox-caption" data-lightbox-caption></span>
        <span class="lightbox-count" data-lightbox-count></span>
      </figcaption>
    </figure>
    <button class="lightbox-btn lightbox-next" type="button" data-lightbox-next aria-label="Next photo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</dialog>
