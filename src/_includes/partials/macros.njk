{#- Photo grid used in the Life Updates feed. Shows up to 4 photos; every photo
    stays in the lightbox gallery, so "+3" opens the rest. -#}
{% macro photoGrid(photos, galleryId, title) %}
{%- set shown = 4 %}
{%- set total = photos | length %}
{%- if total %}
<div class="photo-grid count-{{ total if total < 4 else 4 }}">
  {%- for photo in photos %}
  <a class="photo-link{% if loop.index > shown %} is-hidden{% endif %}" href="{{ photo.image }}" data-gallery="{{ galleryId }}" data-caption="{{ photo.caption or '' }}"{% if loop.index > shown %} hidden tabindex="-1" aria-hidden="true"{% endif %}>
    {%- if loop.index <= shown %}
    <img src="{{ photo.image }}" alt="{{ photo.alt or photo.caption or title }}" loading="lazy" decoding="async">
    {%- if loop.index == shown and total > shown %}
    <span class="photo-more" aria-label="{{ total - shown }} more photos">+{{ total - shown }}</span>
    {%- endif %}
    {%- endif %}
  </a>
  {%- endfor %}
</div>
{%- endif %}
{% endmacro %}

{#- Compact card used on the home page. -#}
{% macro updateCard(post) %}
{%- set photos = post.data.photos | validPhotos %}
{%- set cover = photos | first %}
<article class="update-card{% if not cover %} no-photo{% endif %}">
  <a class="update-card-link" href="{{ post.url }}">
    {%- if cover %}
    <div class="update-card-media">
      <img src="{{ cover.image }}" alt="{{ cover.alt or cover.caption or post.data.title }}" loading="lazy" decoding="async">
      {%- if photos | length > 1 %}<span class="update-card-count">{{ photos | length }} photos</span>{% endif %}
    </div>
    {%- endif %}
    <div class="update-card-body">
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      <h3>{{ post.data.title }}</h3>
      {%- set teaser = (cover.caption if cover and cover.caption else (post.content | plainText)) %}
      {%- if teaser %}<p>{{ teaser | plainText | truncateWords(24) }}</p>{% endif %}
    </div>
  </a>
</article>
{% endmacro %}

{% macro tagList(tags) %}
{%- set list = tags | cleanTags %}
{%- if list | length %}
<ul class="tag-list" aria-label="Tags">
  {%- for tag in list %}
  <li><a href="/updates/tags/{{ tag | slugify }}/">#{{ tag }}</a></li>
  {%- endfor %}
</ul>
{%- endif %}
{% endmacro %}

