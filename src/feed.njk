---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.language }}">
  <title>{{ site.title }}: {{ site.updatesTitle }}</title>
  <subtitle>{{ site.updatesIntro }}</subtitle>
  <link href="{{ '/feed.xml' | absoluteUrl }}" rel="self"/>
  <link href="{{ '/updates/' | absoluteUrl }}"/>
  <id>{{ '/updates/' | absoluteUrl }}</id>
  <updated>{% if collections.updates | length %}{{ collections.updates[0].date | isoDate }}{% else %}{{ page.date | isoDate }}{% endif %}</updated>
  <author><name>{{ profile.name }}</name></author>
  {%- for post in collections.updates | limit(30) %}
  {%- set photos = post.data.photos | validPhotos %}
  {%- set blockList = post.data.blocks | postBlocks %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl }}"/>
    <id>{{ post.url | absoluteUrl }}</id>
    <updated>{{ post.date | isoDate }}</updated>
    {%- set html %}{% for b in blockList %}{% if b.type == "text" %}{{ b.text | md | safe }}{% elif b.type == "photo" %}<p><img src="{{ b.image }}" alt=""></p>{% if b.caption %}<p>{{ b.caption | mdInline | safe }}</p>{% endif %}{% elif b.type == "gallery" %}{% for ph in b.photos %}<p><img src="{{ ph.image }}" alt=""></p>{% if ph.caption %}<p>{{ ph.caption | mdInline | safe }}</p>{% endif %}{% endfor %}{% elif b.type == "video" %}<p><a href="{{ b.video.link }}">{{ b.video.caption or ("Watch on " + b.video.name) }}</a></p>{% elif b.type == "quote" %}<blockquote><p>{{ b.text | mdInline | safe }}</p>{% if b.by %}<p>— {{ b.by }}</p>{% endif %}</blockquote>{% endif %}{% endfor %}{% for photo in photos %}<p><img src="{{ photo.image }}" alt=""></p>{% if photo.caption %}<p>{{ photo.caption | mdInline | safe }}</p>{% endif %}{% endfor %}{% for v in post.data.videos | validVideos %}<p><a href="{{ v.link }}">{{ v.caption or ("Watch the video on " + v.name) }}</a></p>{% endfor %}{{ post.content | safe }}{% endset %}
    <content type="html">{{ html | absolutizeHtml }}</content>
  </entry>
  {%- endfor %}
</feed>
